{
  "name": "phphleb/imageresizer",
  "description": "Custom image resizing with automatic Imagick/GD fallback",
  "type": "library",
  "keywords": ["image", "resizing", "resize", "format", "php"],
  "license": "MIT",
  "authors": [{"name":"Foma Tuturov", "email":"fomiash@yandex.ru"}],
  "require": {"php": ">=7.2.0", "ext-zlib": "*"},
  "suggest": {
    "ext-gd": "Default image processor",
    "ext-imagick": "Alternative processor with ICC color profile support"
  },
  "autoload": {"psr-4": {"Phphleb\\Imageresizer\\": "/", "Phphleb\\Imageresizer\\Src\\": "src"}},
  "minimum-stability": "dev"
}
